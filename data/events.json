[
  {
    "id": "mixed-image-window",
    "events": [
      {
        "kind": "encode_window",
        "image_ids": [
          "img-a",
          "img-b"
        ]
      },
      {
        "kind": "query_effective_weight"
      },
      {
        "kind": "backward",
        "consumer": "classification"
      }
    ]
  },
  {
